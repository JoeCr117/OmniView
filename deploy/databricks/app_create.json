{
  "name": "omniview",
  "description": "OmniView dashboard (ExpenseTracker, Omni-ERD, Admin Portal) - Django + Next.js on Lakebase",
  "resources": [
    {
      "name": "pg",
      "postgres": {
        "branch": "projects/omniview/branches/production",
        "database": "projects/omniview/branches/production/databases/databricks-postgres",
        "permission": "CAN_CONNECT_AND_CREATE"
      }
    },
    {
      "name": "secret_key",
      "secret": {
        "scope": "omniview",
        "key": "secret-key",
        "permission": "READ"
      }
    }
  ]
}
