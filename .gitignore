# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data files
*.csv
*.db
# ...but synthetic CSVs are code, not data - exempt from the ignore above.
# Test fixtures (unit tier) and the documented example source tree.
!backend/apps/expense_tracker/tests/data/**/*.csv
!docs/examples/**/*.csv

# PRODUCTION DATA. Everything under Data/ is ignored by default - it holds a
# real person's finances: the bank CSVs and the budget map, whose
# category/merchant tree names their employer, landlord, insurers, medical
# providers and every place they shop. The only tracked thing is the .gitkeep
# that keeps Data/Banks/ present after a clone. docs/examples/Banks is the
# public stand-in; docs/examples/README.md explains the format.
Data/*
!Data/Banks/
Data/Banks/*
!Data/Banks/README.md

# Playwright E2E: scratch environment (rebuilt by `manage.py e2e_bootstrap`)
# and test artifacts (see frontend/playwright.config.ts)
backend/.e2e/
frontend/test-results/
frontend/playwright-report/

# Local secrets/overrides read by docker/docker-compose.yml. Lives at
# docker/.env (beside the compose file), not here - see docker/README.md.
.env

# Log files
*.log

# Test files (dbt scratch/test data only - not Django tests.py/tests/)
*test_data*

# Deployment STATE, not source: the manifest records the live workspace host,
# Lakebase endpoint hostname, app URL and service-principal client id of a
# specific deployment, and is rewritten by every deploy (see the
# generate-artifact-manifest skill). deploy/databricks/databricks_manifest.example.json
# is the tracked template; the durable operational knowledge lives in
# docs/DEPLOYMENT.md.
deploy/databricks/databricks_manifest.json

# Same reason: the Apps runtime config carries the admin allow-list (real email
# addresses, a privilege grant) and this deployment's app URL / warehouse id.
# deploy/databricks/app.example.yaml is the tracked template.
deploy/databricks/app.yaml

# Per-agent working notes, not part of the source tree.
.claude/agent-memory/

# dbt's per-machine anonymous-usage id (local state)
pipelines/expense_tracker/dbt/.user.yml

# Other files
.vscode/
.mypy_cache
ExpenseVisualizations.pbix

# Django collectstatic output (regenerated by manage.py collectstatic / the
# docker/Dockerfile's build step - see config/urls.py)
backend/staticfiles/

# Raw tool dumps from quality/README.md's measurement commands. The committed
# artefacts are the ratchet baselines and the written audit; everything else in
# reports/ is regenerated output that would otherwise churn every run.
quality/reports/*
!quality/reports/baseline-audit.md
.schemathesis/
frontend/coverage/
.coverage
